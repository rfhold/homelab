      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "editorMode": "code", "expr": "gpu_average_package_power{job=\"integrations/rocm_metrics_exporter\",instance=~\"$instance\",gpu_id=~\"$gpu_id\"}", "legendFormat": "{{instance}} GPU {{gpu_id}}", "range": true, "refId": "A" }
      ],
      "title": "Average Package Power",
      "type": "timeseries"
