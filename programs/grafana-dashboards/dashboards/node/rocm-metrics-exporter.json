      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "editorMode": "code", "expr": "gpu_used_vram{job=\"integrations/rocm_metrics_exporter\",instance=~\"$instance\",gpu_id=~\"$gpu_id\"}", "legendFormat": "{{instance}} GPU {{gpu_id}} used", "range": true, "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "editorMode": "code", "expr": "gpu_total_vram{job=\"integrations/rocm_metrics_exporter\",instance=~\"$instance\",gpu_id=~\"$gpu_id\"}", "legendFormat": "{{instance}} GPU {{gpu_id}} total", "range": true, "refId": "B" }
