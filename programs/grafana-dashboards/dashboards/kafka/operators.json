      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "expr": "sum(jvm_memory_used_bytes{cluster=~\"$cluster\",job=~\"strimzi-(cluster|topic|user)-operator\"}) by (job,area)", "legendFormat": "{{job}} {{area}}", "refId": "A" }],
      "title": "Operator JVM Memory",
      "type": "timeseries"
    }
