      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "expr": "min(strimzi_certificate_expiration_timestamp_ms{job=\"strimzi-cluster-operator\",k8s_cluster_name=~\"$cluster\",resource_namespace=~\"$namespace\",cluster=~\"$kafka_cluster\"}) by (cluster,type,resource_namespace)", "legendFormat": "{{resource_namespace}} {{cluster}} {{type}}", "refId": "A" }],
      "title": "Certificate Expiration",
