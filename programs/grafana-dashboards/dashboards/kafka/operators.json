      "targets": [{ "expr": "strimzi_reconciliations_duration_seconds_max{cluster=~\"$cluster\",job=~\"strimzi-(cluster|topic|user)-operator\",kind=~\"Kafka|KafkaTopic|KafkaNodePool\",namespace=~\"$namespace\"}", "legendFormat": "{{job}} {{kind}}", "refId": "A" }],
      "title": "Maximum Reconciliation Duration",
