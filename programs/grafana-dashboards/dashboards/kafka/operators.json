      "targets": [{ "expr": "sum(strimzi_resources{cluster=~\"$cluster\",job=\"strimzi-topic-operator\",kind=\"KafkaTopic\",namespace=~\"$namespace\",selector=~\"strimzi.io/cluster=$kafka_cluster\"})", "refId": "A" }],
