        { "expr": "sum(increase(strimzi_reconciliations_successful_total{cluster=~\"$cluster\",job=~\"strimzi-(cluster|topic|user)-operator\",kind=~\"Kafka|KafkaTopic|KafkaNodePool\",namespace=~\"$namespace\"}[$__rate_interval])) by (job,kind)", "legendFormat": "{{job}} {{kind}} successful", "refId": "A" },
        { "expr": "sum(increase(strimzi_reconciliations_failed_total{cluster=~\"$cluster\",job=~\"strimzi-(cluster|topic|user)-operator\",kind=~\"Kafka|KafkaTopic|KafkaNodePool\",namespace=~\"$namespace\"}[$__rate_interval])) by (job,kind)", "legendFormat": "{{job}} {{kind}} failed", "refId": "B" }
      ],
      "title": "Reconciliations",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "mimir" },
