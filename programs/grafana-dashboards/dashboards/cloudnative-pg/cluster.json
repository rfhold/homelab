      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "expr": "sum(cnpg_backends_total{k8s_cluster_name=~\"$infrastructure_cluster\",namespace=~\"$namespace\",pod=~\"$instances\"}) by (pod,state)", "legendFormat": "{{pod}} {{state}}", "refId": "A" }],
      "title": "Connections By State",
      "type": "timeseries"
    },
