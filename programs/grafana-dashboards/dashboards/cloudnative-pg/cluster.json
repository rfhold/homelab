      "id": 3,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto", "wideLayout": true },
      "targets": [{ "expr": "sum(max by (datname) (cnpg_pg_database_size_bytes{k8s_cluster_name=~\"$infrastructure_cluster\",namespace=~\"$namespace\",pod=~\"$instances\"}))", "refId": "A" }],
      "title": "Database Size",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto", "wideLayout": true },
      "targets": [{ "expr": "max by (persistentvolumeclaim) (1 - kubelet_volume_stats_available_bytes{cluster=~\"$infrastructure_cluster\",namespace=~\"$namespace\",persistentvolumeclaim=~\"$instances\"} / kubelet_volume_stats_capacity_bytes{cluster=~\"$infrastructure_cluster\",namespace=~\"$namespace\",persistentvolumeclaim=~\"$instances\"})", "legendFormat": "{{persistentvolumeclaim}}", "refId": "A" }],
      "title": "Data Volume Use",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "mimir" },
