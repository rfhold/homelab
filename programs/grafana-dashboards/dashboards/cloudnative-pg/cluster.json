      "targets": [
        { "expr": "cnpg_pg_replication_in_recovery{k8s_cluster_name=~\"$infrastructure_cluster\",namespace=~\"$namespace\",pod=~\"$instances\"}", "legendFormat": "{{pod}} in recovery", "refId": "A" },
        { "expr": "cnpg_pg_replication_is_wal_receiver_up{k8s_cluster_name=~\"$infrastructure_cluster\",namespace=~\"$namespace\",pod=~\"$instances\"}", "legendFormat": "{{pod}} WAL receiver", "refId": "B" }
