      "targets": [
        { "expr": "sum(rate(cnpg_pg_stat_database_blks_hit{k8s_cluster_name=~\"$infrastructure_cluster\",namespace=~\"$namespace\",pod=~\"$instances\"}[$__rate_interval])) by (pod)", "legendFormat": "{{pod}} cache hits", "refId": "A" },
        { "expr": "sum(rate(cnpg_pg_stat_database_blks_read{k8s_cluster_name=~\"$infrastructure_cluster\",namespace=~\"$namespace\",pod=~\"$instances\"}[$__rate_interval])) by (pod)", "legendFormat": "{{pod}} disk reads", "refId": "B" }
