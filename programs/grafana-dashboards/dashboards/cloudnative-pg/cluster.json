      "targets": [
        { "expr": "sum(rate(cnpg_pg_stat_database_deadlocks{k8s_cluster_name=~\"$infrastructure_cluster\",namespace=~\"$namespace\",pod=~\"$instances\"}[$__rate_interval])) by (pod)", "legendFormat": "{{pod}} deadlocks", "refId": "A" },
