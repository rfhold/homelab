        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "expr": "sum(increase(agentgateway_gen_ai_client_token_usage_sum{job=\"agent-gateway\",cluster=~\"$cluster\",gen_ai_request_model=~\"$model\",gen_ai_token_type=\"output\"}[$__range]))",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Output Tokens",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 0,
          "noValue": "0",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 4, "x": 12, "y": 0 },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "expr": "sum(increase(agentgateway_requests_total{job=\"agent-gateway\",cluster=~\"$cluster\",backend=~\"$backend\",status=~\"$status\"}[$__range]))",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Requests",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "description": "Share of selected requests with a 4xx or 5xx status.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 2,
          "noValue": "0%",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.01 }, { "color": "red", "value": 0.05 }] },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 4, "x": 16, "y": 0 },
      "id": 5,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "expr": "sum(increase(agentgateway_requests_total{job=\"agent-gateway\",cluster=~\"$cluster\",backend=~\"$backend\",status=~\"$status\",status=~\"4..|5..\"}[$__range])) / clamp_min(sum(increase(agentgateway_requests_total{job=\"agent-gateway\",cluster=~\"$cluster\",backend=~\"$backend\",status=~\"$status\"}[$__range])), 1e-9)",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Error Percentage",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "description": "Cache-read token units as a share of all reported token units. This does not assume cache-read tokens are a subset of input tokens.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "purple" },
          "decimals": 2,
          "noValue": "0%",
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 4, "x": 20, "y": 0 },
      "id": 6,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "expr": "sum(increase(agentgateway_gen_ai_client_token_usage_sum{job=\"agent-gateway\",cluster=~\"$cluster\",gen_ai_request_model=~\"$model\",gen_ai_token_type=\"input_cache_read\"}[$__range])) / clamp_min(sum(increase(agentgateway_gen_ai_client_token_usage_sum{job=\"agent-gateway\",cluster=~\"$cluster\",gen_ai_request_model=~\"$model\"}[$__range])), 1e-9)",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Cache Read Percentage",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "description": "10-minute smoothed token throughput. Colors identify token type; cache-read series are dashed.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 8, "lineInterpolation": "smooth", "lineWidth": 3, "pointSize": 5, "showPoints": "never", "spanNulls": true, "stacking": { "group": "A", "mode": "none" } },
          "unit": "ops"
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "/.* \/ input$/" },
            "properties": [{ "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byRegexp", "options": "/.* \/ input_cache_read$/" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "purple", "mode": "fixed" } },
              { "id": "custom.lineStyle", "value": { "dash": [8, 8], "fill": "dash" } }
            ]
          },
          {
            "matcher": { "id": "byRegexp", "options": "/.* \/ output$/" },
            "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }]
          }
        ]
      },
      "gridPos": { "h": 10, "w": 8, "x": 0, "y": 5 },
      "id": 7,
      "interval": "1m",
      "options": {
        "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "sum by (gen_ai_request_model, gen_ai_token_type) (rate(agentgateway_gen_ai_client_token_usage_sum{job=\"agent-gateway\",cluster=~\"$cluster\",gen_ai_request_model=~\"$model\"}[10m])) and on (gen_ai_request_model, gen_ai_token_type) sum by (gen_ai_request_model, gen_ai_token_type) (rate(agentgateway_gen_ai_client_token_usage_sum{job=\"agent-gateway\",cluster=~\"$cluster\",gen_ai_request_model=~\"$model\"}[10m])) > 0",
          "legendFormat": "{{gen_ai_request_model}} / {{gen_ai_token_type}}",
          "refId": "A"
        }
      ],
      "title": "Token Throughput by Model and Type",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "continuous-GrYlRd" },
