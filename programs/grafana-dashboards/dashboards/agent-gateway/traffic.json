      "interval": "1m",
      "options": {
        "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, gen_ai_request_model) (rate(agentgateway_gen_ai_server_time_to_first_token_bucket{job=\"agent-gateway\",cluster=~\"$cluster\",gen_ai_request_model=~\"$model\"}[10m]))) and on (gen_ai_request_model) sum by (gen_ai_request_model) (rate(agentgateway_gen_ai_server_time_to_first_token_count{job=\"agent-gateway\",cluster=~\"$cluster\",gen_ai_request_model=~\"$model\"}[10m])) > 0",
          "legendFormat": "{{gen_ai_request_model}} p50",
          "refId": "A"
