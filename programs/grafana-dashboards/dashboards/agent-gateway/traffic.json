    {
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "description": "All reported token units in the selected range, including input, output, cache-read, and any additional token types.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 0,
          "noValue": "0",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "expr": "sum(increase(agentgateway_gen_ai_client_token_usage_sum{job=\"agent-gateway\",cluster=~\"$cluster\",gen_ai_request_model=~\"$model\"}[$__range]))",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "All Tokens",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "blue" },
