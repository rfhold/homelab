      "type": "bargauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "description": "Average observed token usage per reported token-usage observation, grouped by request model and token type.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "continuous-BlYlRd" },
          "decimals": 1,
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 10, "w": 6, "x": 14, "y": 5 },
      "id": 9,
      "options": {
        "displayMode": "lcd",
        "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": false },
        "maxVizHeight": 300,
        "minVizHeight": 16,
        "minVizWidth": 8,
        "namePlacement": "auto",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showUnfilled": true,
        "sizing": "auto",
        "valueMode": "color"
      },
      "targets": [
        {
          "expr": "sum by (gen_ai_request_model, gen_ai_token_type) (increase(agentgateway_gen_ai_client_token_usage_sum{job=\"agent-gateway\",cluster=~\"$cluster\",gen_ai_request_model=~\"$model\"}[$__range])) / clamp_min(sum by (gen_ai_request_model, gen_ai_token_type) (increase(agentgateway_gen_ai_client_token_usage_count{job=\"agent-gateway\",cluster=~\"$cluster\",gen_ai_request_model=~\"$model\"}[$__range])), 1e-9)",
          "instant": true,
          "legendFormat": "{{gen_ai_request_model}} / {{gen_ai_token_type}}",
          "refId": "A"
        }
      ],
      "title": "Average Reported Tokens",
      "type": "bargauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "description": "Independent reported token categories; cache-read is not assumed to be contained within input.",
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "decimals": 0, "unit": "short" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "input" }, "properties": [{ "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "output" }, "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "input_cache_read" }, "properties": [{ "id": "color", "value": { "fixedColor": "purple", "mode": "fixed" } }] }
        ]
      },
      "gridPos": { "h": 10, "w": 4, "x": 20, "y": 5 },
      "id": 10,
      "options": {
        "displayLabels": ["name", "percent"],
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "values": ["value", "percent"] },
        "pieType": "donut",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "tooltip": { "hideZeros": false, "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "expr": "sum by (gen_ai_token_type) (increase(agentgateway_gen_ai_client_token_usage_sum{job=\"agent-gateway\",cluster=~\"$cluster\",gen_ai_request_model=~\"$model\"}[$__range]))",
          "instant": true,
          "legendFormat": "{{gen_ai_token_type}}",
          "refId": "A"
        }
      ],
      "title": "Token Composition",
      "type": "piechart"
    },
    {
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "description": "10-minute smoothed request rate. Line colors identify HTTP status class.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 8, "lineInterpolation": "smooth", "lineWidth": 3, "pointSize": 5, "showPoints": "never", "spanNulls": true, "stacking": { "group": "A", "mode": "none" } },
          "unit": "reqps"
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "/.* \/ 2[0-9][0-9]$/" },
            "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byRegexp", "options": "/.* \/ 3[0-9][0-9]$/" },
            "properties": [{ "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byRegexp", "options": "/.* \/ 4[0-9][0-9]$/" },
            "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byRegexp", "options": "/.* \/ 5[0-9][0-9]$/" },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
          }
        ]
      },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 15 },
      "id": 11,
      "interval": "1m",
      "options": {
        "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "sum by (backend, status) (rate(agentgateway_requests_total{job=\"agent-gateway\",cluster=~\"$cluster\",backend=~\"$backend\",status=~\"$status\"}[10m])) and on (backend, status) sum by (backend, status) (rate(agentgateway_requests_total{job=\"agent-gateway\",cluster=~\"$cluster\",backend=~\"$backend\",status=~\"$status\"}[10m])) > 0",
          "legendFormat": "{{backend}} / {{status}}",
          "refId": "A"
        }
      ],
      "title": "Request Rate by Backend and Status",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "description": "10-minute smoothed error rate. Line colors identify HTTP error status class.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 8, "lineInterpolation": "smooth", "lineWidth": 3, "pointSize": 5, "showPoints": "never", "spanNulls": true, "stacking": { "group": "A", "mode": "none" } },
          "unit": "reqps"
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "/.* \/ 4[0-9][0-9] \/ .*/" },
            "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byRegexp", "options": "/.* \/ 5[0-9][0-9] \/ .*/" },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
          }
        ]
      },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 15 },
      "id": 12,
      "interval": "1m",
      "options": {
        "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "sum by (backend, status, reason) (rate(agentgateway_requests_total{job=\"agent-gateway\",cluster=~\"$cluster\",backend=~\"$backend\",status=~\"$status\",status=~\"4..|5..\"}[10m])) and on (backend, status, reason) sum by (backend, status, reason) (rate(agentgateway_requests_total{job=\"agent-gateway\",cluster=~\"$cluster\",backend=~\"$backend\",status=~\"$status\",status=~\"4..|5..\"}[10m])) > 0",
          "legendFormat": "{{backend}} / {{status}} / {{reason}}",
          "refId": "A"
        }
      ],
      "title": "Error Rate by Backend, Status, and Reason",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "description": "Smoothed request-duration percentiles. P50 is dashed and P95 is solid.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 8, "lineInterpolation": "smooth", "lineWidth": 3, "pointSize": 5, "showPoints": "never", "spanNulls": true, "stacking": { "group": "A", "mode": "none" } },
          "unit": "s"
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "/.* p50$/" },
            "properties": [
              { "id": "custom.lineStyle", "value": { "dash": [8, 8], "fill": "dash" } },
              { "id": "custom.lineWidth", "value": 2 }
            ]
          }
        ]
      },
      "gridPos": { "h": 9, "w": 8, "x": 0, "y": 24 },
      "id": 13,
      "interval": "1m",
      "options": {
        "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, gen_ai_request_model) (rate(agentgateway_gen_ai_server_request_duration_bucket{job=\"agent-gateway\",cluster=~\"$cluster\",gen_ai_request_model=~\"$model\"}[10m]))) and on (gen_ai_request_model) sum by (gen_ai_request_model) (rate(agentgateway_gen_ai_server_request_duration_count{job=\"agent-gateway\",cluster=~\"$cluster\",gen_ai_request_model=~\"$model\"}[10m])) > 0",
          "legendFormat": "{{gen_ai_request_model}} p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, gen_ai_request_model) (rate(agentgateway_gen_ai_server_request_duration_bucket{job=\"agent-gateway\",cluster=~\"$cluster\",gen_ai_request_model=~\"$model\"}[10m]))) and on (gen_ai_request_model) sum by (gen_ai_request_model) (rate(agentgateway_gen_ai_server_request_duration_count{job=\"agent-gateway\",cluster=~\"$cluster\",gen_ai_request_model=~\"$model\"}[10m])) > 0",
          "legendFormat": "{{gen_ai_request_model}} p95",
          "refId": "B"
        }
      ],
      "title": "Request Duration P50 / P95",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "description": "Smoothed time-to-first-token percentiles. P50 is dashed and P95 is solid.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 8, "lineInterpolation": "smooth", "lineWidth": 3, "pointSize": 5, "showPoints": "never", "spanNulls": true, "stacking": { "group": "A", "mode": "none" } },
          "unit": "s"
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "/.* p50$/" },
            "properties": [
              { "id": "custom.lineStyle", "value": { "dash": [8, 8], "fill": "dash" } },
              { "id": "custom.lineWidth", "value": 2 }
            ]
          }
        ]
      },
      "gridPos": { "h": 9, "w": 8, "x": 8, "y": 24 },
