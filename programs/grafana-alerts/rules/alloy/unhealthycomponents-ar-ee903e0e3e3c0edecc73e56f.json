    "folderUid": "alloy"
  },
  "options": {
    "overwrite": true
  },
  "spec": {
    "annotations": {
      "description": "Unhealthy components detected under job {{ $labels.job }}",
      "summary": "Unhealthy components detected."
    },
    "execErrState": "Error",
    "expressions": {
      "A": "{\"model\":{\"datasource\":{\"type\":\"prometheus\",\"uid\":\"mimir\"},\"expr\":\"sum by (cluster, namespace, job) (alloy_component_controller_running_components{health_type!=\\\"healthy\\\"}) > 0\",\"instant\":false,\"intervalMs\":60000,\"maxDataPoints\":43200,\"range\":true,\"refId\":\"A\"},\"datasource_uid\":\"mimir\",\"query_type\":\"\",\"relative_time_range\":{\"from\":\"10m0s\",\"to\":\"0s\"}}",
      "B": "{\"model\":{\"datasource\":{\"type\":\"__expr__\",\"uid\":\"__expr__\"},\"expression\":\"A\",\"intervalMs\":1000,\"maxDataPoints\":43200,\"refId\":\"B\",\"reducer\":\"last\",\"settings\":{\"mode\":\"dropNN\"},\"type\":\"reduce\"},\"source\":true,\"datasource_uid\":\"__expr__\",\"query_type\":\"\"}"
    },
    "for": "15m0s",
    "labels": {
      "severity": "warning"
    },
    "noDataState": "Ok",
    "title": "UnhealthyComponents",
    "trigger": {
      "interval": "1m"
    }
  }
