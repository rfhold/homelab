{
  "metadata": {
    "uid": "ar-c24b2972a5625afbb718ffcc",
    "folderUid": "node"
  },
  "options": {
    "overwrite": true
  },
  "spec": {
    "annotations": {
      "description": "Memory is filling up at {{ $labels.instance }}, has been above 85% for the last 10 minutes, is currently at {{ printf \"%.2f\" $value }}%.\n",
      "summary": "Host is running out of memory."
    },
    "execErrState": "Error",
    "expressions": {
      "A": "{\"model\":{\"datasource\":{\"type\":\"prometheus\",\"uid\":\"mimir\"},\"expr\":\"100 - (node_memory_MemAvailable_bytes{job=~\\\"integrations/(node_exporter|unix)\\\"} / node_memory_MemTotal_bytes{job=~\\\"integrations/(node_exporter|unix)\\\"} * 100) > 85\",\"instant\":false,\"intervalMs\":1000,\"maxDataPoints\":43200,\"range\":true,\"refId\":\"A\"},\"datasource_uid\":\"mimir\",\"query_type\":\"\",\"relative_time_range\":{\"from\":\"10m0s\",\"to\":\"0s\"}}",
      "B": "{\"model\":{\"datasource\":{\"type\":\"__expr__\",\"uid\":\"__expr__\"},\"expression\":\"A\",\"intervalMs\":1000,\"maxDataPoints\":43200,\"refId\":\"B\",\"reducer\":\"last\",\"settings\":{\"mode\":\"dropNN\"},\"type\":\"reduce\"},\"source\":true,\"datasource_uid\":\"__expr__\",\"query_type\":\"\"}"
    },
    "for": "10m0s",
    "labels": {
      "asserts_alert_category": "failure",
      "asserts_entity_type": "Node",
      "asserts_severity": "warning",
      "severity": "warning"
    },
    "noDataState": "Ok",
    "title": "NodeMemoryHighUtilization",
    "trigger": {
      "interval": "1m"
    }
  }
}
