  },
  "spec": {
    "annotations": {
      "description": "Node {{ $labels.instance }} reported {{ printf \"%.0f\" $value }} OOM kills in the last five minutes.\n",
      "summary": "Node reported an OOM kill."
    },
    "execErrState": "Error",
    "expressions": {
      "A": "{\"model\":{\"datasource\":{\"type\":\"prometheus\",\"uid\":\"mimir\"},\"expr\":\"increase(node_vmstat_oom_kill{job=~\\\"integrations/(node_exporter|unix)\\\"}[5m]) > 0\",\"instant\":false,\"intervalMs\":1000,\"maxDataPoints\":43200,\"range\":true,\"refId\":\"A\"},\"datasource_uid\":\"mimir\",\"query_type\":\"\",\"relative_time_range\":{\"from\":\"10m0s\",\"to\":\"0s\"}}",
      "B": "{\"model\":{\"datasource\":{\"type\":\"__expr__\",\"uid\":\"__expr__\"},\"expression\":\"A\",\"intervalMs\":1000,\"maxDataPoints\":43200,\"refId\":\"B\",\"reducer\":\"last\",\"settings\":{\"mode\":\"dropNN\"},\"type\":\"reduce\"},\"source\":true,\"datasource_uid\":\"__expr__\",\"query_type\":\"\"}"
    },
    "labels": {
      "asserts_alert_category": "failure",
      "asserts_entity_type": "Node",
      "asserts_severity": "warning",
      "severity": "warning"
    },
    "noDataState": "Ok",
    "title": "NodeOOMKillDetected",
    "trigger": {
      "interval": "1m"
    }
  }
}
