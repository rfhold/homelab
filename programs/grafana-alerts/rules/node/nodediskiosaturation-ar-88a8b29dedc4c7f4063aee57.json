{
  "metadata": {
    "uid": "ar-88a8b29dedc4c7f4063aee57",
    "folderUid": "node"
  },
  "options": {
    "overwrite": true
  },
  "spec": {
    "annotations": {
      "description": "Disk IO queue (aqu-sq) is high on {{ $labels.device }} at {{ $labels.instance }}, has been above 10 for the last 30 minutes, is currently at {{ printf \"%.2f\" $value }}.\nThis symptom might indicate disk saturation.\n",
      "summary": "Disk IO queue is high."
    },
    "execErrState": "Error",
    "expressions": {
      "A": "{\"model\":{\"datasource\":{\"type\":\"prometheus\",\"uid\":\"mimir\"},\"expr\":\"rate(node_disk_io_time_weighted_seconds_total{job=~\\\"integrations/(node_exporter|unix)\\\", device!=\\\"\\\"}[5m]) > 10\",\"instant\":false,\"intervalMs\":1000,\"maxDataPoints\":43200,\"range\":true,\"refId\":\"A\"},\"datasource_uid\":\"mimir\",\"query_type\":\"\",\"relative_time_range\":{\"from\":\"10m0s\",\"to\":\"0s\"}}",
      "B": "{\"model\":{\"datasource\":{\"type\":\"__expr__\",\"uid\":\"__expr__\"},\"expression\":\"A\",\"intervalMs\":1000,\"maxDataPoints\":43200,\"refId\":\"B\",\"reducer\":\"last\",\"settings\":{\"mode\":\"dropNN\"},\"type\":\"reduce\"},\"source\":true,\"datasource_uid\":\"__expr__\",\"query_type\":\"\"}"
    },
    "for": "30m0s",
    "labels": {
      "asserts_alert_category": "failure",
      "asserts_entity_type": "Node",
      "asserts_severity": "warning",
      "severity": "warning"
    },
    "noDataState": "Ok",
    "title": "NodeDiskIOSaturation",
    "trigger": {
      "interval": "1m"
    }
  }
}
