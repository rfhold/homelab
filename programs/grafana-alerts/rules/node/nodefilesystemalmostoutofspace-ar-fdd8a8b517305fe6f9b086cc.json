{
  "metadata": {
    "uid": "ar-fdd8a8b517305fe6f9b086cc",
    "folderUid": "node"
  },
  "options": {
    "overwrite": true
  },
  "spec": {
    "annotations": {
      "description": "Filesystem on {{ $labels.device }}, mounted on {{ $labels.mountpoint }}, at {{ $labels.instance }} has only {{ printf \"%.2f\" $value }}% available space left.",
      "summary": "Filesystem has less than 3% space left."
    },
    "execErrState": "Error",
    "expressions": {
      "A": "{\"model\":{\"datasource\":{\"type\":\"prometheus\",\"uid\":\"mimir\"},\"expr\":\"(\\n  node_filesystem_avail_bytes{job=~\\\"integrations/(node_exporter|unix)\\\",fstype!=\\\"\\\",mountpoint!=\\\"\\\"} / node_filesystem_size_bytes{job=~\\\"integrations/(node_exporter|unix)\\\",fstype!=\\\"\\\",mountpoint!=\\\"\\\"} * 100 < 3\\nand\\n  node_filesystem_readonly{job=~\\\"integrations/(node_exporter|unix)\\\",fstype!=\\\"\\\",mountpoint!=\\\"\\\"} == 0\\n)\",\"instant\":false,\"intervalMs\":1000,\"maxDataPoints\":43200,\"range\":true,\"refId\":\"A\"},\"datasource_uid\":\"mimir\",\"query_type\":\"\",\"relative_time_range\":{\"from\":\"10m0s\",\"to\":\"0s\"}}",
      "B": "{\"model\":{\"datasource\":{\"type\":\"__expr__\",\"uid\":\"__expr__\"},\"expression\":\"A\",\"intervalMs\":1000,\"maxDataPoints\":43200,\"refId\":\"B\",\"reducer\":\"last\",\"settings\":{\"mode\":\"dropNN\"},\"type\":\"reduce\"},\"source\":true,\"datasource_uid\":\"__expr__\",\"query_type\":\"\"}"
    },
    "for": "30m0s",
    "labels": {
      "severity": "critical"
    },
    "noDataState": "Ok",
    "title": "NodeFilesystemAlmostOutOfSpace",
    "trigger": {
      "interval": "1m"
    }
  }
}
