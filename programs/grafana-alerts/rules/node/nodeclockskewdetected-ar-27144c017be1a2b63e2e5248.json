{
  "metadata": {
    "uid": "ar-27144c017be1a2b63e2e5248",
    "folderUid": "node"
  },
  "options": {
    "overwrite": true
  },
  "spec": {
    "annotations": {
      "description": "Clock at {{ $labels.instance }} is out of sync by more than 0.05s. Ensure NTP is configured correctly on this host.",
      "summary": "Clock skew detected."
    },
    "execErrState": "Error",
    "expressions": {
      "A": "{\"model\":{\"datasource\":{\"type\":\"prometheus\",\"uid\":\"mimir\"},\"expr\":\"(\\n  node_timex_offset_seconds{job=~\\\"integrations/(node_exporter|unix)\\\"} > 0.05\\nand\\n  deriv(node_timex_offset_seconds{job=~\\\"integrations/(node_exporter|unix)\\\"}[5m]) >= 0\\n)\\nor\\n(\\n  node_timex_offset_seconds{job=~\\\"integrations/(node_exporter|unix)\\\"} < -0.05\\nand\\n  deriv(node_timex_offset_seconds{job=~\\\"integrations/(node_exporter|unix)\\\"}[5m]) <= 0\\n)\",\"instant\":false,\"intervalMs\":1000,\"maxDataPoints\":43200,\"range\":true,\"refId\":\"A\"},\"datasource_uid\":\"mimir\",\"query_type\":\"\",\"relative_time_range\":{\"from\":\"10m0s\",\"to\":\"0s\"}}",
      "B": "{\"model\":{\"datasource\":{\"type\":\"__expr__\",\"uid\":\"__expr__\"},\"expression\":\"A\",\"intervalMs\":1000,\"maxDataPoints\":43200,\"refId\":\"B\",\"reducer\":\"last\",\"settings\":{\"mode\":\"dropNN\"},\"type\":\"reduce\"},\"source\":true,\"datasource_uid\":\"__expr__\",\"query_type\":\"\"}"
    },
    "for": "10m0s",
    "labels": {
      "asserts_alert_category": "failure",
      "asserts_entity_type": "Node",
      "asserts_severity": "warning",
      "severity": "warning"
    },
    "noDataState": "Ok",
    "title": "NodeClockSkewDetected",
    "trigger": {
      "interval": "1m"
    }
  }
}
