{
  "metadata": {
    "uid": "ar-35b5174894db4c03cdce4485",
    "folderUid": "loki"
  },
  "options": {
    "overwrite": true
  },
  "spec": {
    "annotations": {
      "description": "{{ $labels.cluster }} {{ $labels.namespace }} has had {{ printf \"%.0f\" $value }} compactors running for more than 5m. Only one compactor should run at a time.\n",
      "summary": "Loki deployment is running more than one compactor."
    },
    "execErrState": "Error",
    "expressions": {
      "A": "{\"model\":{\"datasource\":{\"type\":\"prometheus\",\"uid\":\"mimir\"},\"expr\":\"sum(loki_boltdb_shipper_compactor_running) by (cluster, namespace) > 1\",\"instant\":false,\"intervalMs\":60000,\"maxDataPoints\":43200,\"range\":true,\"refId\":\"A\"},\"datasource_uid\":\"mimir\",\"query_type\":\"\",\"relative_time_range\":{\"from\":\"10m0s\",\"to\":\"0s\"}}",
      "B": "{\"model\":{\"datasource\":{\"type\":\"__expr__\",\"uid\":\"__expr__\"},\"expression\":\"A\",\"intervalMs\":1000,\"maxDataPoints\":43200,\"refId\":\"B\",\"reducer\":\"last\",\"settings\":{\"mode\":\"dropNN\"},\"type\":\"reduce\"},\"source\":true,\"datasource_uid\":\"__expr__\",\"query_type\":\"\"}"
    },
    "for": "5m0s",
    "labels": {
      "severity": "warning"
    },
    "noDataState": "Ok",
    "title": "LokiTooManyCompactorsRunning",
    "trigger": {
      "interval": "1m"
    }
  }
}
