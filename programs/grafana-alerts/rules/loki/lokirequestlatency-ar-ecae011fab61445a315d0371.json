{
  "metadata": {
    "uid": "ar-ecae011fab61445a315d0371",
    "folderUid": "loki"
  },
  "options": {
    "overwrite": true
  },
  "spec": {
    "annotations": {
      "description": "{{ $labels.cluster }} {{ $labels.job }} {{ $labels.route }} is experiencing {{ printf \"%.2f\" $value }}s 99th percentile latency.\n",
      "summary": "Loki request error latency is high."
    },
    "execErrState": "Error",
    "expressions": {
      "A": "{\"model\":{\"datasource\":{\"type\":\"prometheus\",\"uid\":\"mimir\"},\"expr\":\"cluster_namespace_job_route:loki_request_duration_seconds:99quantile{route!~\\\"(?i).*tail.*|/schedulerpb.SchedulerForQuerier/QuerierLoop\\\"} > 1\",\"instant\":false,\"intervalMs\":1000,\"maxDataPoints\":43200,\"range\":true,\"refId\":\"A\"},\"datasource_uid\":\"mimir\",\"query_type\":\"\",\"relative_time_range\":{\"from\":\"10m0s\",\"to\":\"0s\"}}",
      "B": "{\"model\":{\"datasource\":{\"type\":\"__expr__\",\"uid\":\"__expr__\"},\"expression\":\"A\",\"intervalMs\":1000,\"maxDataPoints\":43200,\"refId\":\"B\",\"reducer\":\"last\",\"settings\":{\"mode\":\"dropNN\"},\"type\":\"reduce\"},\"source\":true,\"datasource_uid\":\"__expr__\",\"query_type\":\"\"}"
    },
    "for": "15m0s",
    "labels": {
      "severity": "critical"
    },
    "noDataState": "Ok",
    "title": "LokiRequestLatency",
    "trigger": {
      "interval": "1m"
    }
  }
}
