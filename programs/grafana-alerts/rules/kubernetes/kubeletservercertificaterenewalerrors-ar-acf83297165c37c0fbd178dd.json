{
  "metadata": {
    "uid": "ar-acf83297165c37c0fbd178dd",
    "folderUid": "kubernetes"
  },
  "options": {
    "overwrite": true
  },
  "spec": {
    "annotations": {
      "description": "Kubelet on node {{ $labels.node }} has failed to renew its server certificate ({{ $value | humanize }} errors in the last 5 minutes).",
      "runbook_url": "https://github.com/kubernetes-monitoring/kubernetes-mixin/tree/master/runbook.md#alert-name-kubeletservercertificaterenewalerrors",
      "summary": "Kubelet has failed to renew its server certificate."
    },
    "execErrState": "Error",
    "expressions": {
      "A": "{\"model\":{\"datasource\":{\"type\":\"prometheus\",\"uid\":\"mimir\"},\"expr\":\"increase(kubelet_server_expiration_renew_errors[5m]) > 0\",\"instant\":false,\"intervalMs\":60000,\"maxDataPoints\":43200,\"range\":true,\"refId\":\"A\"},\"datasource_uid\":\"mimir\",\"query_type\":\"\",\"relative_time_range\":{\"from\":\"10m0s\",\"to\":\"0s\"}}",
      "B": "{\"model\":{\"datasource\":{\"type\":\"__expr__\",\"uid\":\"__expr__\"},\"expression\":\"A\",\"intervalMs\":1000,\"maxDataPoints\":43200,\"refId\":\"B\",\"reducer\":\"last\",\"settings\":{\"mode\":\"dropNN\"},\"type\":\"reduce\"},\"source\":true,\"datasource_uid\":\"__expr__\",\"query_type\":\"\"}"
    },
    "for": "15m0s",
    "labels": {
      "severity": "warning"
    },
    "noDataState": "Ok",
    "title": "KubeletServerCertificateRenewalErrors",
    "trigger": {
      "interval": "1m"
    }
  }
}
