{
  "metadata": {
    "uid": "ar-1a68079f7f46f18ea952bf16",
    "folderUid": "kubernetes"
  },
  "options": {
    "overwrite": true
  },
  "spec": {
    "annotations": {
      "description": "Based on recent sampling, the PersistentVolume claimed by {{ $labels.persistentvolumeclaim }} in Namespace {{ $labels.namespace }} {{ with $labels.cluster -}} on Cluster {{ . }} {{- end }} is expected to fill up within four days. Currently {{ $value | humanizePercentage }} is available.",
      "runbook_url": "https://github.com/kubernetes-monitoring/kubernetes-mixin/tree/master/runbook.md#alert-name-kubepersistentvolumefillingup",
      "summary": "PersistentVolume is filling up."
    },
    "execErrState": "Error",
    "expressions": {
      "A": "{\"model\":{\"datasource\":{\"type\":\"prometheus\",\"uid\":\"mimir\"},\"expr\":\"(\\n  kubelet_volume_stats_available_bytes{job=\\\"integrations/kubernetes/kubelet\\\"}\\n    /\\n  kubelet_volume_stats_capacity_bytes{job=\\\"integrations/kubernetes/kubelet\\\"}\\n) < 0.15\\nand\\nkubelet_volume_stats_used_bytes{job=\\\"integrations/kubernetes/kubelet\\\"} > 0\\nand\\npredict_linear(kubelet_volume_stats_available_bytes{job=\\\"integrations/kubernetes/kubelet\\\"}[6h], 4 * 24 * 3600) < 0\\nunless on(cluster, namespace, persistentvolumeclaim)\\nkube_persistentvolumeclaim_access_mode{ access_mode=\\\"ReadOnlyMany\\\"} == 1\\nunless on(cluster, namespace, persistentvolumeclaim)\\nkube_persistentvolumeclaim_labels{label_excluded_from_alerts=\\\"true\\\"} == 1\",\"instant\":false,\"intervalMs\":60000,\"maxDataPoints\":43200,\"range\":true,\"refId\":\"A\"},\"datasource_uid\":\"mimir\",\"query_type\":\"\",\"relative_time_range\":{\"from\":\"10m0s\",\"to\":\"0s\"}}",
      "B": "{\"model\":{\"datasource\":{\"type\":\"__expr__\",\"uid\":\"__expr__\"},\"expression\":\"A\",\"intervalMs\":1000,\"maxDataPoints\":43200,\"refId\":\"B\",\"reducer\":\"last\",\"settings\":{\"mode\":\"dropNN\"},\"type\":\"reduce\"},\"source\":true,\"datasource_uid\":\"__expr__\",\"query_type\":\"\"}"
    },
    "for": "1h0m0s",
    "labels": {
      "severity": "warning"
    },
    "noDataState": "Ok",
    "title": "KubePersistentVolumeFillingUp",
    "trigger": {
      "interval": "1m"
    }
  }
}
