{
  "metadata": {
    "uid": "ar-573bc0baf4e609f1de3457ca",
    "folderUid": "kubernetes"
  },
  "options": {
    "overwrite": true
  },
  "spec": {
    "annotations": {
      "description": "Client certificate for Kubelet on node {{ $labels.node }} expires in {{ $value | humanizeDuration }}.",
      "runbook_url": "https://github.com/kubernetes-monitoring/kubernetes-mixin/tree/master/runbook.md#alert-name-kubeletclientcertificateexpiration",
      "summary": "Kubelet client certificate is about to expire."
    },
    "execErrState": "Error",
    "expressions": {
      "A": "{\"model\":{\"datasource\":{\"type\":\"prometheus\",\"uid\":\"mimir\"},\"expr\":\"kubelet_certificate_manager_client_ttl_seconds < 604800\",\"instant\":false,\"intervalMs\":60000,\"maxDataPoints\":43200,\"range\":true,\"refId\":\"A\"},\"datasource_uid\":\"mimir\",\"query_type\":\"\",\"relative_time_range\":{\"from\":\"10m0s\",\"to\":\"0s\"}}",
      "B": "{\"model\":{\"datasource\":{\"type\":\"__expr__\",\"uid\":\"__expr__\"},\"expression\":\"A\",\"intervalMs\":1000,\"maxDataPoints\":43200,\"refId\":\"B\",\"reducer\":\"last\",\"settings\":{\"mode\":\"dropNN\"},\"type\":\"reduce\"},\"source\":true,\"datasource_uid\":\"__expr__\",\"query_type\":\"\"}"
    },
    "labels": {
      "severity": "warning"
    },
    "noDataState": "Ok",
    "title": "KubeletClientCertificateExpiration",
    "trigger": {
      "interval": "1m"
    }
  }
}
