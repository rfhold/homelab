{
  "metadata": {
    "uid": "ar-1460b28a41e8651d8b38a2f2",
    "folderUid": "kubernetes"
  },
  "options": {
    "overwrite": true
  },
  "spec": {
    "annotations": {
      "description": "The API server is burning too much error budget.",
      "runbook_url": "https://github.com/kubernetes-monitoring/kubernetes-mixin/tree/master/runbook.md#alert-name-kubeapierrorbudgetburn",
      "summary": "The API server is burning too much error budget."
    },
    "execErrState": "Error",
    "expressions": {
      "A": "{\"model\":{\"datasource\":{\"type\":\"prometheus\",\"uid\":\"mimir\"},\"expr\":\"sum by(cluster) (apiserver_request:burnrate1h) > (14.40 * 0.01000)\\nand on(cluster)\\nsum by(cluster) (apiserver_request:burnrate5m) > (14.40 * 0.01000)\",\"instant\":false,\"intervalMs\":1000,\"maxDataPoints\":43200,\"range\":true,\"refId\":\"A\"},\"datasource_uid\":\"mimir\",\"query_type\":\"\",\"relative_time_range\":{\"from\":\"10m0s\",\"to\":\"0s\"}}",
      "B": "{\"model\":{\"datasource\":{\"type\":\"__expr__\",\"uid\":\"__expr__\"},\"expression\":\"A\",\"intervalMs\":1000,\"maxDataPoints\":43200,\"refId\":\"B\",\"reducer\":\"last\",\"settings\":{\"mode\":\"dropNN\"},\"type\":\"reduce\"},\"source\":true,\"datasource_uid\":\"__expr__\",\"query_type\":\"\"}"
    },
    "for": "2m0s",
    "labels": {
      "long": "1h",
      "severity": "critical",
      "short": "5m"
    },
    "noDataState": "Ok",
    "title": "KubeAPIErrorBudgetBurn",
    "trigger": {
      "interval": "1m"
    }
  }
}
