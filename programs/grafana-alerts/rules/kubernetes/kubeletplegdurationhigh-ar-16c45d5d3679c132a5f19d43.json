{
  "metadata": {
    "uid": "ar-16c45d5d3679c132a5f19d43",
    "folderUid": "kubernetes"
  },
  "options": {
    "overwrite": true
  },
  "spec": {
    "annotations": {
      "description": "The Kubelet Pod Lifecycle Event Generator has a 99th percentile duration of {{ $value }} seconds on node {{ $labels.node }}.",
      "runbook_url": "https://github.com/kubernetes-monitoring/kubernetes-mixin/tree/master/runbook.md#alert-name-kubeletplegdurationhigh",
      "summary": "Kubelet Pod Lifecycle Event Generator is taking too long to relist."
    },
    "execErrState": "Error",
    "expressions": {
      "A": "{\"model\":{\"datasource\":{\"type\":\"prometheus\",\"uid\":\"mimir\"},\"expr\":\"node_quantile:kubelet_pleg_relist_duration_seconds:histogram_quantile{quantile=\\\"0.99\\\"} >= 10\",\"instant\":false,\"intervalMs\":1000,\"maxDataPoints\":43200,\"range\":true,\"refId\":\"A\"},\"datasource_uid\":\"mimir\",\"query_type\":\"\",\"relative_time_range\":{\"from\":\"10m0s\",\"to\":\"0s\"}}",
      "B": "{\"model\":{\"datasource\":{\"type\":\"__expr__\",\"uid\":\"__expr__\"},\"expression\":\"A\",\"intervalMs\":1000,\"maxDataPoints\":43200,\"refId\":\"B\",\"reducer\":\"last\",\"settings\":{\"mode\":\"dropNN\"},\"type\":\"reduce\"},\"source\":true,\"datasource_uid\":\"__expr__\",\"query_type\":\"\"}"
    },
    "for": "5m0s",
    "labels": {
      "severity": "warning"
    },
    "noDataState": "Ok",
    "title": "KubeletPlegDurationHigh",
    "trigger": {
      "interval": "1m"
    }
  }
}
