{
  "metadata": {
    "uid": "ar-dfae25c739ce03cb3d85edc3",
    "folderUid": "cert-manager"
  },
  "options": {
    "overwrite": true
  },
  "spec": {
    "annotations": {
      "description": "New certificates will not be able to be minted, and existing ones can't be renewed until cert-manager is back.",
      "runbook_url": "https://gitlab.com/uneeq-oss/cert-manager-mixin/-/blob/master/RUNBOOK.md#certmanagerabsent",
      "summary": "Cert Manager has disappeared from Prometheus service discovery."
    },
    "execErrState": "Error",
    "expressions": {
      "A": "{\"model\":{\"datasource\":{\"type\":\"prometheus\",\"uid\":\"mimir\"},\"expr\":\"absent(certmanager_clock_time_seconds)\",\"instant\":false,\"intervalMs\":60000,\"maxDataPoints\":43200,\"range\":true,\"refId\":\"A\"},\"datasource_uid\":\"mimir\",\"query_type\":\"\",\"relative_time_range\":{\"from\":\"10m0s\",\"to\":\"0s\"}}",
      "B": "{\"model\":{\"datasource\":{\"type\":\"__expr__\",\"uid\":\"__expr__\"},\"expression\":\"A\",\"intervalMs\":1000,\"maxDataPoints\":43200,\"refId\":\"B\",\"reducer\":\"last\",\"settings\":{\"mode\":\"dropNN\"},\"type\":\"reduce\"},\"source\":true,\"datasource_uid\":\"__expr__\",\"query_type\":\"\"}"
    },
    "for": "10m0s",
    "labels": {
      "severity": "critical"
    },
    "noDataState": "Ok",
    "title": "CertManagerAbsent",
    "trigger": {
      "interval": "1m"
    }
  }
}
