{
  "metadata": {
    "uid": "ar-f20a75357c3b958f673f9176",
    "folderUid": "ceph"
  },
  "options": {
    "overwrite": true
  },
  "spec": {
    "annotations": {
      "description": "The Ceph cluster has critical issues. Run the ceph -s command on any Ceph node to identify the reason and resolve the issue depending on the output.",
      "summary": "The Ceph cluster has critical issues."
    },
    "execErrState": "Error",
    "expressions": {
      "A": "{\"model\":{\"datasource\":{\"type\":\"prometheus\",\"uid\":\"mimir\"},\"expr\":\"ceph_health_status == 2\",\"instant\":false,\"intervalMs\":1000,\"maxDataPoints\":43200,\"range\":true,\"refId\":\"A\"},\"datasource_uid\":\"mimir\",\"query_type\":\"\",\"relative_time_range\":{\"from\":\"10m0s\",\"to\":\"0s\"}}",
      "B": "{\"model\":{\"datasource\":{\"type\":\"__expr__\",\"uid\":\"__expr__\"},\"expression\":\"A\",\"intervalMs\":1000,\"maxDataPoints\":43200,\"refId\":\"B\",\"reducer\":\"last\",\"settings\":{\"mode\":\"dropNN\"},\"type\":\"reduce\"},\"source\":true,\"datasource_uid\":\"__expr__\",\"query_type\":\"\"}"
    },
    "for": "5m0s",
    "labels": {
      "severity": "critical"
    },
    "noDataState": "Ok",
    "title": "CephUnhealthyCritical",
    "trigger": {
      "interval": "1m"
    }
  }
}
