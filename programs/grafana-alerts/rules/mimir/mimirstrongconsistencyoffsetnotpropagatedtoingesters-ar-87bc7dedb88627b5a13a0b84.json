  "options": {
    "overwrite": true
  },
  "spec": {
    "annotations": {
      "message": "Mimir ingesters in {{ $labels.cluster }}/{{ $labels.namespace }} are receiving an unexpected high number of strongly consistent requests without an offset specified.",
      "runbook_url": "https://grafana.com/docs/mimir/latest/operators-guide/mimir-runbooks/#mimirstrongconsistencyoffsetnotpropagatedtoingesters"
    },
    "execErrState": "Error",
    "expressions": {
      "A": "{\"model\":{\"datasource\":{\"type\":\"prometheus\",\"uid\":\"mimir\"},\"expr\":\"sum by (cluster, namespace) (rate(cortex_ingest_storage_strong_consistency_requests_total{component=\\\"partition-reader\\\", with_offset=\\\"false\\\"}[1m]))\\n/\\nsum by (cluster, namespace) (rate(cortex_ingest_storage_strong_consistency_requests_total{component=\\\"partition-reader\\\"}[1m]))\\n* 100 > 5\",\"instant\":false,\"intervalMs\":1000,\"maxDataPoints\":43200,\"range\":true,\"refId\":\"A\"},\"datasource_uid\":\"mimir\",\"query_type\":\"\",\"relative_time_range\":{\"from\":\"10m0s\",\"to\":\"0s\"}}",
      "B": "{\"model\":{\"datasource\":{\"type\":\"__expr__\",\"uid\":\"__expr__\"},\"expression\":\"A\",\"intervalMs\":1000,\"maxDataPoints\":43200,\"refId\":\"B\",\"reducer\":\"last\",\"settings\":{\"mode\":\"dropNN\"},\"type\":\"reduce\"},\"source\":true,\"datasource_uid\":\"__expr__\",\"query_type\":\"\"}"
    },
    "for": "5m0s",
    "labels": {
      "severity": "warning"
    },
    "noDataState": "Ok",
    "title": "MimirStrongConsistencyOffsetNotPropagatedToIngesters",
    "trigger": {
      "interval": "1m"
    }
  }
}
