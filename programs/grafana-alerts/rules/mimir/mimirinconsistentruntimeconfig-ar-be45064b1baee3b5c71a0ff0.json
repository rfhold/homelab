{
  "metadata": {
    "uid": "ar-be45064b1baee3b5c71a0ff0",
    "folderUid": "mimir"
  },
  "options": {
    "overwrite": true
  },
  "spec": {
    "annotations": {
      "message": "An inconsistent runtime config file is used across cluster {{ $labels.cluster }}/{{ $labels.namespace }}.\n",
      "runbook_url": "https://grafana.com/docs/mimir/latest/operators-guide/mimir-runbooks/#mimirinconsistentruntimeconfig"
    },
    "execErrState": "Error",
    "expressions": {
      "A": "{\"model\":{\"datasource\":{\"type\":\"prometheus\",\"uid\":\"mimir\"},\"expr\":\"count(count by(cluster, namespace, job, sha256) (cortex_runtime_config_hash)) without(sha256) > 1\",\"instant\":false,\"intervalMs\":1000,\"maxDataPoints\":43200,\"range\":true,\"refId\":\"A\"},\"datasource_uid\":\"mimir\",\"query_type\":\"\",\"relative_time_range\":{\"from\":\"10m0s\",\"to\":\"0s\"}}",
      "B": "{\"model\":{\"datasource\":{\"type\":\"__expr__\",\"uid\":\"__expr__\"},\"expression\":\"A\",\"intervalMs\":1000,\"maxDataPoints\":43200,\"refId\":\"B\",\"reducer\":\"last\",\"settings\":{\"mode\":\"dropNN\"},\"type\":\"reduce\"},\"source\":true,\"datasource_uid\":\"__expr__\",\"query_type\":\"\"}"
    },
    "for": "1h0m0s",
    "labels": {
      "severity": "critical"
    },
    "noDataState": "Ok",
    "title": "MimirInconsistentRuntimeConfig",
    "trigger": {
      "interval": "1m"
    }
  }
}
