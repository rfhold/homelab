{
  "metadata": {
    "uid": "ar-415fda7d6de05906336a8d19",
    "folderUid": "mimir"
  },
  "options": {
    "overwrite": true
  },
  "spec": {
    "annotations": {
      "message": "Mimir cluster {{ $labels.cluster }}/{{ $labels.namespace }} has {{ printf \"%f\" $value }} unhealthy ingester(s).",
      "runbook_url": "https://grafana.com/docs/mimir/latest/operators-guide/mimir-runbooks/#mimiringesterunhealthy"
    },
    "execErrState": "Error",
    "expressions": {
      "A": "{\"model\":{\"datasource\":{\"type\":\"prometheus\",\"uid\":\"mimir\"},\"expr\":\"min by (cluster, namespace) (cortex_ring_members{state=\\\"Unhealthy\\\", name=\\\"ingester\\\"}) > 0\",\"instant\":false,\"intervalMs\":1000,\"maxDataPoints\":43200,\"range\":true,\"refId\":\"A\"},\"datasource_uid\":\"mimir\",\"query_type\":\"\",\"relative_time_range\":{\"from\":\"10m0s\",\"to\":\"0s\"}}",
      "B": "{\"model\":{\"datasource\":{\"type\":\"__expr__\",\"uid\":\"__expr__\"},\"expression\":\"A\",\"intervalMs\":1000,\"maxDataPoints\":43200,\"refId\":\"B\",\"reducer\":\"last\",\"settings\":{\"mode\":\"dropNN\"},\"type\":\"reduce\"},\"source\":true,\"datasource_uid\":\"__expr__\",\"query_type\":\"\"}"
    },
    "for": "15m0s",
    "labels": {
      "severity": "critical"
    },
    "noDataState": "Ok",
    "title": "MimirIngesterUnhealthy",
    "trigger": {
      "interval": "1m"
    }
  }
}
