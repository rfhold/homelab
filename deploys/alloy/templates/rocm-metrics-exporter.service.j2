[Unit]
Description=ROCm Metrics Exporter
Documentation=https://github.com/ROCm/device-metrics-exporter
Wants=network-online.target
Requires=docker.service
After=network-online.target docker.service

[Service]
Type=simple
User=root
Group=root
ExecStartPre=-/usr/bin/docker rm --force {{ container_name | tojson }}
ExecStart=/usr/bin/docker run --rm --name {{ container_name | tojson }} --publish {{ ("127.0.0.1:" ~ port | string ~ ":" ~ container_port | string) | tojson }}{% for device in devices %} --device {{ device | tojson }}{% endfor %}{% for docker_arg in docker_args %} {{ docker_arg | tojson }}{% endfor %} {{ image | tojson }}
ExecStop=-/usr/bin/docker stop --time 30 {{ container_name | tojson }}
ExecStopPost=-/usr/bin/docker rm --force {{ container_name | tojson }}
Restart=always
RestartSec=15s
TimeoutStartSec=0
TimeoutStopSec=45s
KillMode=process
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
