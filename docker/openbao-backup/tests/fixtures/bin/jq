#!/usr/bin/env bash
set -euo pipefail

case "$*" in
  *"rtrimstr"*)
    cat >/dev/null
    printf '{"role":"fixture","jwt":"redacted"}\n'
    ;;
  *".auth.client_token"*)
    cat >/dev/null
    printf 'fixture-token-not-real\n'
    ;;
  *".Contents"*)
    cat >/dev/null
    printf '%s' "${MOCK_COMPLETION_KEYS:-}"
    ;;
  *".Uploads"*)
    cat >/dev/null
    printf '%s' "${MOCK_MULTIPART:-}"
    ;;
  *)
    exit 1
    ;;
esac
