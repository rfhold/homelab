#!/usr/bin/env bash
set -euo pipefail

case "$*" in
  *"/v1/auth/kubernetes/login")
    printf '{"auth":{"client_token":"fixture-token-not-real"}}\n'
    ;;
  *"/v1/sys/storage/raft/snapshot")
    if [[ "${MOCK_SNAPSHOT_SLOW:-}" == 1 ]]; then
      : >"$FIXTURE_STATE/snapshot-started"
      trap 'exit 143' TERM INT HUP
      while :; do
        :
      done
    fi
    printf 'snapshot-plaintext-fixture'
    ;;
  *)
    exit 1
    ;;
esac
